{
  "name": "n8n-nodes-medhira",
  "version": "1.0.1",
  "description": "Convert Markdown to PDF inside n8n using Puppeteer - A Medhira community package",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "markdown",
    "pdf",
    "puppeteer",
    "medhira"
  ],
  "license": "Apache-2.0",
  "author": "MEDHIRA <hello.medhira@gmail.com>",
  "main": "dist/nodes/MarkdownToPdf/MarkdownToPdf.node.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && copyfiles \"nodes/**/*.svg\" \"nodes/**/*.json\" dist/",
    "prepublishOnly": "npm run build",
    "docs:build": "mkdocs build",
    "docs:serve": "mkdocs serve"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "marked": "^18.0.4",
    "puppeteer": "^25.1.0",
    "sanitize-html": "^2.17.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/sanitize-html": "^2.16.1",
    "copyfiles": "^2.4.1",
    "n8n-workflow": "^2.23.0",
    "typescript": "^6.0.3"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/MarkdownToPdf/MarkdownToPdf.node.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HELLOMEDHIRA/n8n-nodes-medhira"
  },
  "homepage": "https://medhira.readthedocs.io/en/latest/n8n-nodes-medhira/",
  "bugs": {
    "url": "https://github.com/HELLOMEDHIRA/n8n-nodes-medhira/issues"
  }
}
